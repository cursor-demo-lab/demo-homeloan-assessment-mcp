          "type": "string",
          "minLength": 1,
          "description": "The file id, for example \"app-mia-dan\""
        }
      },
      "required": ["applicationId"],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sent": {
          "type": "boolean",
          "const": false
        },
        "howItIsSent": {
          "type": "string",
          "const": "Nothing is sent from here. Priya's 'Ask for more info' decision sends the 'more information needed' text."
        },
        "fromCall": {
          "description": "The intake answers this reply used that came from the latest call. Everything else is the demo script's.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "applicant_1_name",
              "applicant_1_employment",
              "applicant_1_income",
              "applicant_2_name",
              "applicant_2_employment",
              "applicant_2_income",
              "target_area",
              "purchase_price",
              "deposit",
              "first_home",
              "declared_debts"
            ]
          }
        }
      },
      "required": ["to", "text", "sent", "howItIsSent"],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "hand_over_to_assessor",
    "title": "Hand over to Credit Decision",
    "description": "Gets the file ready to hand over from Credit Assessment to Credit Decision. It doesn't move the file: Priya Raman hands it over in the app, and she decides. This demo server keeps no records: the reply is the handover record, and nothing is written anywhere else. Without confirm it returns what it will record. Handing over always takes two messages from Priya. When she first asks you to hand a file over, call hand_over_to_assessor without confirm, show her what it will record, and ask her to confirm; do not set confirm yet, even though she asked. Set confirm to true only when her next message confirms. It records no decision.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "description": "The file id, for example \"app-mia-dan\""
        },
        "confirm": {
          "description": "true only when Priya confirms, in her message after the preview",
          "type": "boolean"
        }
      },
      "required": ["applicationId"],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["needs-confirmation", "ready-to-hand-over"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage": {
          "type": "string",
          "enum": [
            "voice-intake",
            "credit-assessment",
            "credit-decision",
            "fulfilment",
            "fulfilment-check",
            "settlement"
          ]
        },
        "message": {
          "type": "string"
        },
        "fromCall": {
          "description": "The intake answers this reply used that came from the latest call. Everything else is the demo script's.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "applicant_1_name",
              "applicant_1_employment",
              "applicant_1_income",
              "applicant_2_name",
              "applicant_2_employment",
              "applicant_2_income",
              "target_area",
              "purchase_price",
              "deposit",
              "first_home",
              "declared_debts"
            ]
          }
        }
      },
      "required": ["applicationId", "reference", "status", "findings", "stage", "message"],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "idempotentHint": true
    }
  }
]
